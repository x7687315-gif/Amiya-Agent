# 复制为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxx

# DeepSeek OpenAI 兼容接口地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# 生成参数
TEMPERATURE=0.9
MAX_TOKENS=1024
TIMEOUT=30

# 短期记忆保留的轮数上限（每轮 = 1 用户 + 1 助手）
HISTORY_LIMIT=20

# 长期记忆（SQLite）。设为 0 退回纯内存模式，不在本地留任何对话记录
MEMORY_ENABLED=1
MEMORY_DB_PATH=data/assistant.db

# 记忆嵌入（本地运行，不占显存）
# 后端：auto（有 sentence-transformers 用本地模型，否则回退纯 stdlib 哈希）/ local（强制本地模型）/ hashing（强制回退）
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 每轮对话注入提示词的最相关记忆条数
MEMORY_TOP_K=5

# 角色知识库（Knowledge RAG）：knowledge/ 目录下的 *.md 静态语料（设定/世界观/风格）
# 与长期记忆（Memory）物理隔离——知识是"设定"，记忆是"经历"，互不混入。
# 目录不存在时自动关闭知识检索，不报错。
KNOWLEDGE_DIR=knowledge
# 每轮对话注入提示词的最相关知识片段条数
KNOWLEDGE_TOP_K=4

# 语音（🔊 朗读）：档案名对应 core/tts/voice_profiles/<name>.yaml，
# 换声音只需换档案名，不用改代码；语言与 GPT-SoVITS /tts 契约一致（zh/en/…）
TTS_VOICE=assistant
TTS_TEXT_LANG=zh
# 语音功能总开关：1=启用朗读（默认），0=彻底关闭（🔊 按钮隐藏、不发起合成）。
# 与会话级静音（顶栏 🔊/🔇）不同——这是「可关闭」的持久开关，重启仍生效。
TTS_ENABLED=1

# UI 皮肤：auto = 跟随情绪（calm→starry / thinking→winter / worried→pale / happy→warm，
# 情绪超过 24h 失效回落 starry）；也可填具体皮肤 id 强制（starry/warm/winter/pale）。
# 换肤重启后生效。单一字段，无独立开关。
UI_SKIN=auto
