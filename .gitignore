# 虚拟环境
.venv/
.venv_bak/
.venv_py314/

# 密钥（含 DeepSeek API Key，绝不入库）
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 用户数据（对话记录 / 长期记忆 SQLite）
data/

# 语音参考音频（用户自备，版权不入库；profile yaml 会入库，wav 不入；
# 克隆后需自备 core/tts/voice_profiles/<name>/reference.wav）
voices/
core/tts/voice_profiles/*/*.wav

# 运行日志 / 诊断输出
logs/
TTS_FOREGROUND_LOG.txt
tts_web/_*.log

# TTS 诊断台的生成音频（可再生成，体积大）
tts_web/outputs/

# 用户个人文稿（仅本地测试素材）
tts_web/user_essay.txt

# 安装日志 / 备份
install.log
*.bak

# IDE
.idea/
.vscode/

# ---------------------------------------------------------------------------
# 隐私 / 仅本地资产（公开发布前绝不可入库）
# ---------------------------------------------------------------------------
# 密钥与证书
*.pem
*.key
*.p12
*.token
*.secret
secrets/
private/

# 个人素材 / 私人皮肤（用户自备，含版权素材）
personal_assets/
personal_skins/

# 模型权重（语音 / 嵌入等，体积大且多为版权或私有）
models/
weights/
voice_models/
voice_samples/

# 记忆与数据库（含用户长期记忆 SQLite）
memory/
*.db
*.sqlite
*.sqlite3

# 环境配置（含 API Key，已由 .env 覆盖但双保险）
.env.*
!.env.example

# ---------------------------------------------------------------------------
# 缓存 / 杂项（不入库）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.log
.DS_Store
Thumbs.db

